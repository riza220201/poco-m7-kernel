# patches/series — applied in order by apply-mods.sh to EVERY non-stock variant,
# onto the pristine pinned tree (sources.lock KERNEL_COMMON_REF), before ksunext.
# Each patch was generated from one commit of the porting tree and is applied with
# strict `git apply` — no fuzz. ORDER MATTERS.
#
# columns:  <patch>  <config switch it needs, or ->  <symbol that must be in System.map>
# build.sh checks the last two after every build: a passing KMI gate proves the
# ABI, not the feature set — a kernel with these silently dropped gates clean too.
10-bore-7.0.0-515-kabi.patch    CONFIG_SCHED_BORE            update_curr_bore
20-ntsync-mainline.patch        CONFIG_NTSYNC                ntsync_misc
30-reflex-0.4.0-515.patch       CONFIG_CPU_FREQ_GOV_REFLEX   reflex_gov
40-creek-balance.patch          CONFIG_CREEK_BALANCE         creek_balance_init
50-adios-3.3.0-515.patch        CONFIG_MQ_IOSCHED_ADIOS      mq_adios
60-kcompressd-0.5-515.patch     CONFIG_KCOMPRESSD            kcompressd_nodes
70-le9uo-1.14-515.patch         -                            sysctl_workingset_protection
# 80 is KMI-sensitive (tcp_sock / tcp_skb_cb / rate_sample / tcp_congestion_ops):
# BUILD_BUG_ONs in tcp_bbr.c pin the 5.15 sizes and offsets; gate layers 1 & 4 verify the CRCs.
80-bbr3-515-kabi.patch          CONFIG_TCP_CONG_BBR          bbr_skb_marked_lost
90-hid-sony-ds4-clones.patch    CONFIG_HID_SONY              dualshock4_set_default_calibration
