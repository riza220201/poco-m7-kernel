diff --git a/mm/Kconfig b/mm/Kconfig
index fb3cfd1684fccc2416adbe78596399b498e16a96..3dd9d61b5e8f3a21aca3f8835655a92820cbd60e 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
